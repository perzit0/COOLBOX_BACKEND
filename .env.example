# ============================================================
# LOCAL (PostgreSQL en tu máquina) — usa estas 5 líneas mientras
# desarrollas en tu compu.
# ============================================================
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=colbox_db

# ============================================================
# SUPABASE / RENDER (producción) — comenta las 5 líneas de arriba
# y descomenta esta con tu connection string real de Supabase:
# ============================================================
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Dominio de correo institucional permitido para Usuario
DOMINIO_CORREO_INSTITUCIONAL=@coolbox.com

# URL exacta del frontend en Vercel (solo para producción en Render).
# En local puedes dejarla vacía o en "*"
ALLOWED_ORIGIN=*

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
